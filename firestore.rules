rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This application reads and writes Firestore only via the authenticated
    // server-side Firebase Admin SDK. The browser must not access documents
    // directly, including drafts and unpublished obituary records.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
